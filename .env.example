# Copy to .env and fill in. .env is git-ignored: never commit credentials.
# Referenced from the YAML config as ${NAME}.

AURORA_EXPORTER_CONFIG=config/aurora-exporter.yaml

# Redshift: postgres:// or redshift:// URL. Use sslmode=verify-full in production.
REDSHIFT_DSN=postgres://user:password@cluster.region.redshift.amazonaws.com:5439/datahub?sslmode=require

# Target (Aurora PostgreSQL / PostgreSQL)
HOTDATA_DSN=postgres://user:password@cluster.region.rds.amazonaws.com:5432/hotdata?sslmode=require

# Bearer token for /v1 endpoints (empty disables auth; do not leave empty in production)
AURORA_EXPORTER_API_TOKEN=
